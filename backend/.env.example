# Copiar a .env y completar. NO subir .env a git.
PORT=5000
NODE_ENV=development

# MongoDB local: instalar Mongo Community o levantar con docker
# docker run --name mongo-desapp -p 27017:27017 -d mongo:7
MONGO_URI=mongodb://localhost:27017/desapp_grupo7

# JWT (sprint 2)
# JWT_SECRET=cambiame
# JWT_EXPIRES_IN=7d

# Mail Configuration (Nodemailer)
# MAIL_HOST=smtp.mailtrap.io
# MAIL_PORT=2525
# MAIL_USER=tu_usuario
# MAIL_PASS=tu_password
# MAIL_FROM=no-reply@asistente.edu
# MAIL_SECURE=false

# Frontend URL for links
FRONTEND_URL=http://localhost:5173

# Login con Google (OAuth). Client ID del proyecto en Google Cloud Console.
# Debe ser el MISMO valor que VITE_GOOGLE_CLIENT_ID en el frontend.
# GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com

# Materiales en Google Cloud Storage. Si no se define GCS_BUCKET, los archivos
# se guardan en disco local (uploads/) como hasta ahora.
# GCS_BUCKET=nombre-del-bucket
# Ruta al JSON de la service account (rol Storage Object Admin sobre el bucket).
# GOOGLE_APPLICATION_CREDENTIALS=./gcs-service-account.json
