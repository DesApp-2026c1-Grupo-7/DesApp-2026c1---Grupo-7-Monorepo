# Copiar a .env y completar. NO subir .env a git.
PORT=5000
NODE_ENV=development

# MongoDB local: instalar Mongo Community o levantar con docker
# docker run --name mongo-desapp -p 27017:27017 -d mongo:7
MONGO_URI=mongodb://localhost:27017/desapp_grupo7

# JWT (sprint 2)
# JWT_SECRET=cambiame
# JWT_EXPIRES_IN=7d

# Mail Configuration (Nodemailer)
# MAIL_HOST=smtp.mailtrap.io
# MAIL_PORT=2525
# MAIL_USER=tu_usuario
# MAIL_PASS=tu_password
# MAIL_FROM=no-reply@asistente.edu
# MAIL_SECURE=false

# Frontend URL for links
FRONTEND_URL=http://localhost:5173

# Login con Google (OAuth). El Client ID NO es secreto (va en el bundle del front),
# por eso queda acá para que el equipo pueda probar el login con Google.
# Debe ser el MISMO valor que VITE_GOOGLE_CLIENT_ID en el frontend.
GOOGLE_CLIENT_ID=385273852557-jugmj7hque17c05froav3b792rmlpuit.apps.googleusercontent.com

# Materiales en Google Cloud Storage. Si NO definís GCS_BUCKET, los archivos se
# guardan en disco local (uploads/) y no hace falta credencial (modo dev, ya funciona).
# Para usar el bucket real, descomentá las 2 líneas de abajo Y pedile a un compañero
# el archivo gcs-service-account.json (NO se versiona) y dejalo en backend/.
# GCS_BUCKET=estudiantes_unahur
# GOOGLE_APPLICATION_CREDENTIALS=./gcs-service-account.json
