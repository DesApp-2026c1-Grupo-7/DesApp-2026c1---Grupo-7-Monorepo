# Copiar a .env y completar. NO subir .env a git.

# URL del backend
VITE_API_URL=http://localhost:5000/api

# Login con Google (OAuth). Client ID del proyecto en Google Cloud Console.
# Debe ser el MISMO valor que GOOGLE_CLIENT_ID en el backend.
# Si no se define, el botón de Google no aparece y queda solo el login con email/password.
# VITE_GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
